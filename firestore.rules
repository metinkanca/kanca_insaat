rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = user whose ID token carries the `admin: true` custom claim.
    // The claim can only be granted with the Firebase Admin SDK (service
    // account) via scripts/set-admin-claim.cjs — never from client code.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ---- Catalog: public read, admin-only write ----
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Selling units ("birim") admins add from the Birim Ayarla page. Read is
    // public so the catalog can label prices without an extra auth hop.
    match /units/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brandGroups/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homeConfig/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Extra photos for the Hakkımızda gallery, one document per photo.
    match /galleryImages/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- Orders ----
    // Guests and dealers create orders at checkout. A dealerId, when present,
    // must belong to the signed-in user. Only admin reads/manages all orders;
    // dealers can read their own (queries must filter on dealerId).
    match /orders/{doc} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.keys().hasAll(['customerName', 'email', 'phone', 'total', 'currency', 'items', 'createdAt'])
        && (!('dealerId' in request.resource.data)
            || isSelf(request.resource.data.dealerId));
      allow read: if isAdmin()
        || (request.auth != null && resource.data.dealerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- Dealers ----
    // Registration creates the caller's own doc with status 'pending'.
    // Dealers read only their own doc; approval/edits are admin-only.
    match /dealers/{uid} {
      // Admins create accounts manually; self-registration creates own doc.
      allow create: if isAdmin()
        || (isSelf(uid) && request.resource.data.status == 'pending');
      allow read: if isAdmin() || isSelf(uid);
      allow update, delete: if isAdmin();
    }

    // ---- Quote requests ----
    // Dealers create quotes for themselves and read their own; admin manages.
    // Admins also create quotes on a dealer's behalf from the Teklif Ekle page
    // (e.g. a list phoned/faxed in), so isAdmin() is an alternative to isSelf.
    match /quoteRequests/{doc} {
      allow create: if isAdmin()
        || (isSelf(request.resource.data.dealerId)
            && request.resource.data.status == 'pending');
      allow read: if isAdmin()
        || (request.auth != null && resource.data.dealerId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---- Dealer ledger (cari hesap) ----
    // Dealers read their own entries; only admin writes.
    match /dealerPayments/{doc} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.dealerId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ---- Admin bildirimleri ----
    // Raised by the site itself when a bayi applies, an order is placed or a
    // quote is submitted (src/notify.ts). Create is open because a guest
    // checking out is not signed in — but only in this exact shape, capped in
    // size, and always unread, so the collection cannot be used as free
    // storage. Reading and clearing them is admin-only.
    match /notifications/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'title', 'body', 'link', 'refId', 'read', 'createdAt'])
        && request.resource.data.keys().hasAll(['type', 'title', 'body', 'read', 'createdAt'])
        && request.resource.data.type in ['dealer', 'order', 'quote']
        && request.resource.data.read == false
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Everything not matched above is denied by default.
  }
}
