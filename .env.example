# Copy this file to .env and fill in the values. .env is gitignored — no project
# keys are stored in this repository.
#
# On Cloudflare Pages set these same variables under
# Settings → Environment variables (add them to BOTH Production and Preview),
# then redeploy. Vite only reads VITE_-prefixed vars at build time.

# Firebase web config — Console → Project settings → Your apps → SDK setup.
# Required; the site throws a setup error on load without them.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# OCR.space API key — powers the "Liste Yükleyerek" quote upload and admin OCR
# import. Optional: without it those features show a "not configured" message
# and the rest of the site works normally.
VITE_OCR_SPACE_KEY=your-ocr-space-key-here
